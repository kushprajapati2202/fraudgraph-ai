# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey (no quotes, no spaces).
GEMINI_API_KEY=
# Optional: use Vertex AI on Google Cloud instead of an API key (uses Application Default Credentials).
# GEMINI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# Primary model, then fallbacks tried in order if the primary is retired, overloaded, rate-limited or slow.
# Check what your key can use with: python scripts/check_gemini.py
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=30
# Embedding model for "similar cases"
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: when set, reset / synthetic-transaction endpoints require header X-Demo-Token
DEMO_TOKEN=
# Optional: SQLite file location (default: ./fraudgraph.db; Cloud Run: /tmp/fraudgraph.db)
DB_PATH=
# ---- Google Cloud integrations (all optional; set by scripts/deploy.sh on Cloud Run) ----
# GCS_STATE_BUCKET=your-project-fraudgraph          # SQLite snapshot: state survives restarts
# BIGQUERY_DATASET=fraudgraph                       # analytics mirror, Ask BigQuery, BigQuery ML
# BIGQUERY_LOCATION=US
# PUBSUB_TOPIC=fraudgraph-transfers                 # event-driven ingest
# PUBSUB_PUSH_TOKEN=                                # shared secret on the push subscription URL
# DOCAI_PROCESSOR=projects/<p>/locations/us/processors/<id>   # Document AI second reader
# VERTEX_SEARCH_SERVING_CONFIG=projects/<p>/locations/global/collections/default_collection/engines/fraudgraph-policy-search/servingConfigs/default_search
